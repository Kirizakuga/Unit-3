# Copies /home/<user>/.face to SDDM's faces folder (started by unit3-avatar@<user>.path).
# The helper reads the file as the user and only accepts JPEG/PNG; the service is sandboxed.
[Unit]
Description=Copy %i's avatar to the SDDM login screen

[Service]
Type=oneshot
ExecStart=/usr/local/bin/unit3-avatar-sync %i
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/usr/share/sddm/faces
ProtectHome=read-only
PrivateTmp=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
